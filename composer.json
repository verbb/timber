{
    "name": "verbb/timber",
    "description": "View Craft application logs in the control panel \u2014 filter, search, and stream in real time.",
    "type": "craft-plugin",
    "version": "2.1.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "timber"
    ],
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/timber/issues?state=open",
        "source": "https://github.com/verbb/timber",
        "docs": "https://github.com/verbb/timber",
        "rss": "https://github.com/verbb/timber/commits/v2.atom"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "nystudio107/craft-plugin-vite": "^5.0.0",
        "workerman/phpsocket.io": "^v1.1.16",
        "workerman/phpsocket.io-emitter": "^v1.0.2",
        "verbb/base": "^3.0.0",
        "verbb/parallel-process": "^1.0.3",
        "yii2mod/yii2-array-query": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "verbb\\timber\\": "src/"
        }
    },
    "extra": {
        "name": "Timber",
        "handle": "timber",
        "changelogUrl": "https://raw.githubusercontent.com/verbb/timber/craft-5/CHANGELOG.md",
        "class": "verbb\\timber\\Timber"
    },
    "require-dev": {
        "craftcms/cms": "^5.9",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "yiisoft/yii2-shell": "^2.0.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest --bootstrap tests/bootstrap-craft.php -c phpunit.craft.xml tests",
        "test:setup": "@php tests/bin/test-setup.php",
        "test:all": "./vendor/bin/pest --bootstrap tests/bootstrap-craft.php -c phpunit.craft.xml tests"
    }
}
